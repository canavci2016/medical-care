<!doctype html>
<html lang='en'>
  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=utf-8' />
    <title>Add Hair Result</title>
    <meta name='viewport' content='width=device-width, initial-scale=1.0, user-scalable=yes' />
    <link rel='stylesheet' href='/css/admin/adminlte.css' />
    <link
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css'
      crossorigin='anonymous'
    />
    <link
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css'
      crossorigin='anonymous'
    />
  </head>
  <body class='layout-fixed sidebar-expand-lg sidebar-open bg-body-tertiary'>
    <div class='app-wrapper'>
      {{> adminheader}}
      {{> hospitalsidebar}}

      <main class='app-main'>
        <div class='app-content-header'>
          <div class='container-fluid'>
            <div class='row align-items-center'>
              <div class='col-sm-6'><h3 class='mb-0'>Add Hair Result</h3></div>
            </div>
          </div>
        </div>

        <div class='app-content'>
          <div class='container-fluid'>
            <div class='card card-primary card-outline'>
              <div class='card-body'>
                <div class='row'>
                  <div class='col-md-6 mb-3'>
                    <label for='procedureType' class='form-label'>Procedure Type</label>
                    <select class='form-select' id='procedureType' required>
                      {{#each procedureTypes}}
                        <option value='{{this}}'>{{this}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div class='col-md-6 mb-3'>
                    <label for='technique' class='form-label'>Technique</label>
                    <select class='form-select' id='technique' required>
                      {{#each techniques}}
                        <option value='{{this}}'>{{this}}</option>
                      {{/each}}
                    </select>
                  </div>
                </div>

                <div class='row'>
                  <div class='col-md-6 mb-3'>
                    <label for='graftCount' class='form-label'>Graft Count</label>
                    <input type='number' min='0' class='form-control' id='graftCount' required />
                  </div>
                  <div class='col-md-6 mb-3'>
                    <label for='monthsAfter' class='form-label'>Months After</label>
                    <input type='number' min='0' class='form-control' id='monthsAfter' required />
                  </div>
                </div>

                <div class='mb-3'>
                  <label for='availableMonths' class='form-label'>Available Months (comma separated)</label>
                  <input type='text' class='form-control' id='availableMonths' placeholder='0,1,3,6,12' required />
                </div>

                <div class='mb-3'>
                  <label class='form-label d-block mb-2'>Treatment Areas</label>
                  {{#each treatmentAreas}}
                    <div class='form-check form-check-inline'>
                      <input class='form-check-input' type='checkbox' name='treatmentAreas' id='treatmentArea-{{@index}}' value='{{this}}' />
                      <label class='form-check-label' for='treatmentArea-{{@index}}'>{{this}}</label>
                    </div>
                  {{/each}}
                </div>

                <div class='mb-3'>
                  <label for='operationDate' class='form-label'>Operation Date</label>
                  <input type='date' class='form-control' id='operationDate' />
                </div>

                <div class='mb-3'>
                  <label for='imageUrls' class='form-label'>Image URLs (comma separated)</label>
                  <input type='text' class='form-control' id='imageUrls' placeholder='https://...' />
                </div>

                <div class='mb-3'>
                  <label for='imageFile' class='form-label'>Upload Image</label>
                  <input type='file' class='form-control' id='imageFile' accept='image/*' />
                  <button type='button' class='btn btn-secondary mt-2' id='uploadImageBtn'>Upload &amp; Add URL</button>
                </div>

                <div class='mb-3'>
                  <label for='patientStory' class='form-label'>Patient Story</label>
                  <textarea class='form-control' id='patientStory' rows='3'></textarea>
                </div>

                <div class='form-check mb-3'>
                  <input class='form-check-input' type='checkbox' id='isPublic' checked />
                  <label class='form-check-label' for='isPublic'>Public</label>
                </div>

                <div id='createResultAlert' class='alert d-none' role='alert'></div>

                <button type='button' class='btn btn-success' id='submitResultBtn'>Save Hair Result</button>
              </div>
            </div>
          </div>
        </div>
      </main>

      {{> adminfooter}}
    </div>

    <script
      src='https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js'
      crossorigin='anonymous'
    ></script>
    <script
      src='https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js'
      crossorigin='anonymous'
    ></script>
    <script
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js'
      crossorigin='anonymous'
    ></script>
    <script src='/scripts/admin/js/adminlte.js'></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const sidebarWrapper = document.querySelector('.sidebar-wrapper');
        if (sidebarWrapper && OverlayScrollbarsGlobal?.OverlayScrollbars !== undefined) {
          OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
            scrollbars: {
              theme: 'os-theme-light',
              autoHide: 'leave',
              clickScroll: true,
            },
          });
        }
      });

      document.addEventListener('DOMContentLoaded', function () {
        const imageUrlsInput = document.getElementById('imageUrls');
        const imageFileInput = document.getElementById('imageFile');
        const uploadImageBtn = document.getElementById('uploadImageBtn');
        const submitBtn = document.getElementById('submitResultBtn');
        const alertBox = document.getElementById('createResultAlert');

        const showAlert = (message, type) => {
          alertBox.textContent = message;
          alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
          alertBox.classList.add(type === 'success' ? 'alert-success' : 'alert-danger');
        };

        uploadImageBtn.addEventListener('click', async function () {
          const file = imageFileInput.files && imageFileInput.files[0];
          if (!file) {
            showAlert('Please select an image file first.', 'error');
            return;
          }

          uploadImageBtn.disabled = true;

          try {
            const response = await fetch('/hospital/dashboard/hair-results/upload-url', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ contentType: file.type }),
            });

            if (!response.ok) {
              throw new Error('Could not get upload url.');
            }

            const { url } = await response.json();

            const uploadResponse = await fetch(url, {
              method: 'PUT',
              headers: { 'Content-Type': file.type },
              body: file,
            });

            if (!uploadResponse.ok) {
              throw new Error('Could not upload image.');
            }

            const finalUrl = uploadResponse.url.split('?')[0];
            const existing = imageUrlsInput.value.trim();
            imageUrlsInput.value = existing ? `${existing},${finalUrl}` : finalUrl;
            imageFileInput.value = '';
            showAlert('Image uploaded and added to list.', 'success');
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Unexpected error occurred.';
            showAlert(message, 'error');
          } finally {
            uploadImageBtn.disabled = false;
          }
        });

        submitBtn.addEventListener('click', async function () {
          submitBtn.disabled = true;
          alertBox.classList.add('d-none');

          const availableMonths = String(document.getElementById('availableMonths').value || '')
            .split(',')
            .map((value) => parseInt(value.trim(), 10))
            .filter((value) => !Number.isNaN(value));

          const imageUrls = String(imageUrlsInput.value || '')
            .split(',')
            .map((value) => value.trim())
            .filter(Boolean);

          const treatmentAreas = Array.from(
            document.querySelectorAll('input[name="treatmentAreas"]:checked'),
          ).map((input) => input.value);

          const operationDateValue = document.getElementById('operationDate').value;

          const payload = {
            procedureType: document.getElementById('procedureType').value,
            technique: document.getElementById('technique').value,
            graftCount: Number(document.getElementById('graftCount').value || 0),
            monthsAfter: Number(document.getElementById('monthsAfter').value || 0),
            availableMonths,
            treatmentAreas: treatmentAreas.length ? treatmentAreas : undefined,
            operationDate: operationDateValue || undefined,
            imageUrls: imageUrls.length ? imageUrls : undefined,
            patientStory: String(document.getElementById('patientStory').value || '').trim() || undefined,
            isPublic: document.getElementById('isPublic').checked,
          };

          try {
            const response = await fetch('/hospital/dashboard/hair-results', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify(payload),
            });

            if (!response.ok) {
              const responseText = await response.text();
              let responseBody = null;

              if (responseText) {
                try {
                  responseBody = JSON.parse(responseText);
                } catch (error) {
                  responseBody = null;
                }
              }

              const errorMessage =
                responseBody?.message ||
                responseBody?.error ||
                response.statusText ||
                'Hair result could not be created.';

              throw new Error(Array.isArray(errorMessage) ? errorMessage.join(', ') : errorMessage);
            }

            window.location.href = '/hospital/dashboard/hair-results';
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Unexpected error occurred.';
            showAlert(message, 'error');
            submitBtn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
