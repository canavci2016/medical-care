      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="sep">›</span>
        <span>Hair Transplant in {{ucwords country.name}}</span>
      </div>
    </div>
  </section>

  <!-- CITY STATS -->
  <section class="stats-bar">
    <div class="container">
      <div class="stat-item fade-in">
        <span class="stat-number" data-count="{{results.pagination.total}}">{{results.pagination.total}}</span>
