<!-- ARTICLE HEADER -->
<section class='page-header' style='padding: 80px 0;'>
  <div class='container' style='max-width: 800px;'>
    <div class='breadcrumb' style='margin-bottom: 16px;'>
      <a href='/'>Home</a>
      <span class='sep'>›</span>
      <a href='/blogs'>Blog</a>
      <span class='sep'>›</span>
      {{#if blog.category}}
        <a href='/blogs?cat={{blog.category.id}}'>{{blog.category.name}}</a>
        <span class='sep'>›</span>
      {{/if}}
      <span>{{blog.title}}</span>
    </div>
    <span
      class='badge badge-green'
      style='margin-bottom: 12px;'
    >Techniques</span>
    <h1 style='font-size: 38px; line-height: 1.25;'>{{blog.title}}</h1>
    <div
      style='display: flex; align-items: center; gap: 16px; margin-top: 20px; flex-wrap: wrap;padding-left: 40px;'
    >
      <div
        style='display: flex; gap: 16px; font-size: 13px; color: rgba(255,255,255,0.6);'
      >
        <span>📅 March 20, 2026</span>
        <span>⏱ {{blog.readingTime}} min read</span>
        <span>💬 0 comments</span>
      </div>
    </div>
  </div>
</section>

<!-- ARTICLE CONTENT -->
<section class='section' style='padding-top: 48px;'>
  <div class='container'>
    <div class='detail-main' style='grid-template-columns: 1fr 340px;'>
      <div class='detail-left'>
        <!-- Hero Image -->
        <div
          style='border-radius: var(--radius-md); overflow: hidden; margin-bottom: 32px;'
        >
          <img
            src='{{blog.featuredImage}}'
            alt='FUE Hair Transplant Procedure'
            style='width: 100%; height: 400px; object-fit: cover;'
          />
        </div>

        <!-- Article Body -->
        <article class='blog-article'>
          <h2>{{blog.title}}</h2>
          <p>{{{blog.content}}}</p>

          <div class='blog-callout'>
            <div class='blog-callout-icon'>💡</div>
            <div>
              <strong>Key Fact:</strong>
              Modern FUE procedures have a success rate of 95-98% when performed
              by experienced surgeons, with transplanted hair lasting a
              lifetime.
            </div>
          </div>

          <div
            class='blog-callout'
            style='background: rgba(27,77,122,0.06); border-color: var(--secondary);'
          >
            <div class='blog-callout-icon'>🔍</div>
            <div>
              <strong>Need Help?</strong>
              Our team at HairRestore Hub can match you with a verified surgeon
              based on your specific needs, budget, and location.
              <a
                href='/contact'
                style='color: var(--accent); font-weight: 600;'
              >Get a free consultation →</a>
            </div>
          </div>

          <!-- Share -->
          <div class='blog-share'>
            <span
              style='font-weight: 600; font-size: 14px; color: var(--text-primary);'
            >Share this article:</span>
            <div class='blog-share-buttons'>
              <a href='#' class='blog-share-btn'>𝕏 Twitter</a>
              <a href='#' class='blog-share-btn'>f Facebook</a>
              <a href='#' class='blog-share-btn'>in LinkedIn</a>
              <a href='#' class='blog-share-btn'>📧 Email</a>
            </div>
          </div>
        </article>
      </div>

      <!-- SIDEBAR -->
      <div class='detail-sidebar'>

        <!-- Related Posts -->
        <div class='sidebar-card fade-in' style='margin-top: 20px;'>
          <h3>Recent Articles</h3>
          <div class='blog-related-list'>
            {{#each recentBlogs}}
              <a href='/blogs/{{this.slug}}' class='blog-related-item'>
                <img src='{{this.featuredImage}}' alt='{{this.title}}' />
                <div>
                  <h4>{{this.title}}</h4>
                  <span>{{this.readingTime}} min read</span>
                </div>
              </a>
            {{/each}}

          </div>
        </div>
      </div>
    </div>
  </div>
</section>