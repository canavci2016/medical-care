<!-- PAGE HEADER -->
<section class='page-header'>
  <div class='container'>
    <h1>{{seo.h1Title}}</h1>
    <p>Real before and after photos from documented hair transplant cases</p>
    <div class='breadcrumb'>
      <a href='/'>Home</a>
      <span class='sep'>›</span>
      <span>Hair Transplant Results</span>
    </div>
  </div>
</section>

<!-- FILTER + RESULTS -->
<section class='section'>
  <div class='container'>

<div class="filter-container">

  <button
    type="button"
    class="filter-toggle"
    id="filterToggle"
    aria-expanded="true"
    aria-controls="filterBar"
  >
    <span><i class="fa-solid fa-sliders"></i> Filters ({{selectedFilterCount}})</span>
    <span class="filter-toggle-icon">⌃</span>
  </button>

  <form
    class="filter-bar"
    id="filterBar"
    method="GET"
    action="/results"
  >
    <select name="technique">
      <option value="">Techniques</option>
      {{#each filters.techniques}}
        <option {{#if selected}}selected{{/if}} value="{{value}}">
          {{label}}
        </option>
      {{/each}}
    </select>

    <select name="graftCount">
      <option value="">Graft Counts</option>
      {{#each filters.graftCounts}}
        <option {{#if selected}}selected{{/if}} value="{{value}}">
          {{label}}
        </option>
      {{/each}}
    </select>

    <select name="ageRange">
      <option value="">All Age ranges</option>
      {{#each filters.ageRanges}}
        <option
          value="{{this.value}}"
          {{#if this.selected}}selected{{/if}}
        >
          {{this.label}}
        </option>
      {{/each}}
    </select>

    <select name="monthAfter">
      <option value="">Result timeline</option>
      {{#each filters.monthAfter}}
        <option
          value="{{this.value}}"
          {{#if this.selected}}selected{{/if}}
        >
          {{this.label}}
        </option>
      {{/each}}
    </select>

    <select
      class="hospital-list select2"
      name="hospitalId"
      id="hospitalId"
      data-placeholder="Hospitals"
    ></select>

    <button type="submit" class="btn btn-primary btn-sm">
      Apply
    </button>
  </form>

</div>

 <div class="results-count">
  Showing
 <strong> {{pagination.page}}–{{pagination.totalPages}} </strong>
of
<strong> {{pagination.total}} </strong>
results
 </div>

    <div class='grid-3' id='resultsGrid'>

      {{#each results}}
  
     <a href="/results/{{this.id}}" class="card filterable-card fade-in" data-technique="{{this.technique}}" data-grafts="{{this.graftCount}}" data-hospital="{{this.hospital.name}}">
          <div class="card-image">
            <img src="{{this.previewImageUrl}}" alt="{{this.graftCount}} graft {{toUpperCase this.technique}} hair transplant result before and after">
            <div class="overlay">
              <span class="badge badge-blue">{{this.technique}}</span>
              <span class="badge badge-green">{{this.graftCount}} Grafts</span>
            </div>
          </div>
          <div class="card-body">
            <h3>{{this.technique}} Hair Transplant — {{this.graftCount}} Grafts</h3>
            <div class="ba-meta">
              <span>🏥 {{this.hospital.name}}</span>
              <span>📅 Result after {{this.monthsAfter}} months</span>
            </div>
            <span class="view-detail-link">View Full Case →</span>
          </div>
        </a>
      {{/each}}

    </div>

    <!-- Pagination -->
    <div
      class='pagination'
      data-pagination='resultsGrid'
      data-total-pages='{{pagination.totalPages}}'
    ></div>
  </div>
</section>

<!-- CTA -->
<section class='cta-section'>
  <div class='container'>
    <h2>Find Results Similar to Yours</h2>
    <p>Compare documented cases by technique, graft count, hair-loss pattern and recovery period.</p>
    <div class='cta-actions'>
      <a href='/contact' class='btn btn-primary'>Get A Consultation</a>
      <a
        href='/clinics'
        class='btn btn-outline'
        style='border-color: #fff; color: #fff;'
      >Explore Clinics</a>
    </div>
  </div>
</section>

<script>

  $(document).ready(function() {

  $('.hospital-list').select2({
    theme: 'select2',
    ajax: {
        url: '/hospitals/api',
        dataType: 'json',
        delay: 250, // wait 250 milliseconds before triggering the request
        data: function(params) {
            var query = {
                name: params.term,
                page: params.page || 1,
                limit: 10,
            }

            // Query parameters will be ?search=[term]&page=[page]
            return query;
        },
        processResults: function(data, params) {
            // Transforms the top-level key of the response object from 'items' to 'results'

            let results= data.data.map(function(hospital) {
                    return {
                        id: hospital.id,
                        text: hospital.name
                    };
                });

            // Only show "All Hospitals" option on the first page and when there's no search term
            if ((!params.page || params.page === 1) && !params.term) {
                results = [{id: 'all-hospitals', text: 'All Hospitals'}, ...results];
            }

            return {
                results: results,
                pagination: {
                   more: data.pagination.hasNext
                 }
            };
        }
        // Additional AJAX parameters go here; see the end of this page for the full code of this example
    }
});


const selectedHospitalId = '{{filters.hospitalId}}';
var hospitalSelect = $('#hospitalId');
if (selectedHospitalId) {
    // Fetch the hospital data for the selected hospital ID
$.ajax({
    type: 'GET',
    url: '/hospitals/api/' + selectedHospitalId,
}).then(function(data) {
  const res=data.data;
    // create the option and append to Select2
    var option = new Option(res.name, res.id, true, true);
    hospitalSelect.append(option);

    // manually trigger the `select2:select` event
    hospitalSelect.trigger({
        type: 'select2:select',
        params: {
            data: res
        }
    });
    $('#hospitalId').trigger('change');
});

$('#hospitalId').on("change", function(e) {
  if(e.target.value === 'all-hospitals'){
$('#hospitalId').val(null).trigger('change');
  }
});

}


const filterContainer = $('.filter-container');
const filterToggle = $('#filterToggle');

if (window.innerWidth <= 768) {
    filterContainer.addClass('collapsed');
    filterToggle.attr('aria-expanded', 'false');
}


filterToggle.on('click', function () {

    const isCollapsed = filterContainer.hasClass('collapsed');

    filterContainer.toggleClass('collapsed');

    filterToggle.attr(
        'aria-expanded',
        isCollapsed ? 'true' : 'false'
    );

});

});

</script>