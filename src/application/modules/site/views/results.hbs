<!-- PAGE HEADER -->
<section class='page-header'>
  <div class='container'>
    <h1>{{seo.h1Title}}</h1>
    <p>Real before and after photos from verified patients. See the
      transformations achieved by our partner hospitals.</p>
    <div class='breadcrumb'>
      <a href='/'>Home</a>
      <span class='sep'>›</span>
      <span>Results</span>
    </div>
  </div>
</section>

<!-- FILTER + RESULTS -->
<section class='section'>
  <div class='container'>

   <form class='filter-bar' method='GET' action='/results'>
      <select name='procedure'>
        <option value=''>Procedures</option>
      {{#each filters.procedures}}
        <option {{#if selected}}selected{{/if}} value='{{value}}'>{{label}}</option>
      {{/each}}
      </select>
      <select name='technique'>
        <option value=''>All Techniques</option>
      {{#each filters.techniques}}
        <option {{#if selected}}selected{{/if}} value='{{value}}'>{{label}}</option>
      {{/each}}
      </select>
      <select name='graftCount'>
        <option value=''>Graft Counts</option>
     {{#each filters.graftCounts}}
        <option {{#if selected}}selected{{/if}} value='{{value}}'>{{label}}</option>
      {{/each}}
      </select>
      <select name='ageRange'>
        <option value=''>All Age ranges</option>
         {{#each filters.ageRanges}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
      <select class="hospital-list select2" name="hospitalId" id="hospitalId" data-placeholder="Hospitals">
      </select>

      <button type='submit' class='btn btn-primary btn-sm'>Search</button>
    </form>

    <div class='grid-3' id='resultsGrid'>

      {{#each results}}
  
     <a href="/results/{{this.id}}" class="card filterable-card fade-in" data-technique="{{this.technique}}" data-grafts="{{this.graftCount}}" data-hospital="{{this.hospital.name}}">
          <div class="card-image">
            <img src="{{this.previewImageUrl}}" alt="{{this.graftCount}} graft {{toUpperCase this.technique}} hair transplant result before and after">
            <div class="overlay">
              <span class="badge badge-blue">{{this.technique}}</span>
              <span class="badge badge-green">{{this.graftCount}} Grafts</span>
            </div>
          </div>
          <div class="card-body">
            <h3>{{this.technique}} Hair Transplant — {{this.graftCount}} Grafts</h3>
            <div class="ba-meta">
              <span>🏥 {{this.hospital.name}}</span>
              <span>📅 {{relative_date this.operationDate}}</span>
            </div>
            <span class="view-detail-link">View Full Case →</span>
          </div>
        </a>
      {{/each}}

    </div>

    <!-- Pagination -->
    <div
      class='pagination'
      data-pagination='resultsGrid'
      data-total-pages='{{pagination.totalPages}}'
    ></div>
  </div>
</section>

<!-- CTA -->
<section class='cta-section'>
  <div class='container'>
    <h2>Want Results Like These?</h2>
    <p>Book a free consultation with one of our expert surgeons and start your
      transformation journey today.</p>
    <div class='cta-actions'>
      <a href='/contact' class='btn btn-primary'>Get Free Consultation</a>
      <a
        href='/doctors'
        class='btn btn-outline'
        style='border-color: #fff; color: #fff;'
      >Browse Doctors</a>
    </div>
  </div>
</section>

<script>

  $(document).ready(function() {

  $('.hospital-list').select2({
    theme: 'select2',
    ajax: {
        url: '/hospitals/api',
        dataType: 'json',
        delay: 250, // wait 250 milliseconds before triggering the request
        data: function(params) {
            var query = {
                name: params.term,
                page: params.page || 1,
                limit: 10,
            }

            // Query parameters will be ?search=[term]&page=[page]
            return query;
        },
        processResults: function(data) {
            // Transforms the top-level key of the response object from 'items' to 'results'
            
            let results= data.data.map(function(hospital) {
                    return {
                        id: hospital.id,
                        text: hospital.name
                    };
                });

        results=[...[{id: 'all-hospitals', text: 'All Hospitals'}],...results];
            return {
                results: results,
                pagination: {
                   more: data.pagination.hasNext
                 }
            };
        }
        // Additional AJAX parameters go here; see the end of this page for the full code of this example
    }
});


const selectedHospitalId = '{{filters.hospitalId}}';
var hospitalSelect = $('#hospitalId');
if (selectedHospitalId) {
    // Fetch the hospital data for the selected hospital ID
$.ajax({
    type: 'GET',
    url: '/hospitals/api/' + selectedHospitalId,
}).then(function(data) {
  const res=data.data;
    // create the option and append to Select2
    var option = new Option(res.name, res.id, true, true);
    hospitalSelect.append(option);

    // manually trigger the `select2:select` event
    hospitalSelect.trigger({
        type: 'select2:select',
        params: {
            data: res
        }
    });
    $('#hospitalId').trigger('change');
});

$('#hospitalId').on("change", function(e) {
  if(e.target.value === 'all-hospitals'){
$('#hospitalId').val(null).trigger('change');
  }
});

}


});

</script>