<section class='detail-hero'></section>

<!-- PROFILE HEADER -->
<section class='detail-content'>
  <div class='container'>
    <div class='profile-header'>
      <div class='profile-image'>
        <img src='{{hospital.coverImageUrl}}' alt='{{hospital.name}}' />
      </div>
      <div class='profile-info'>
        <h1>{{hospital.name}}</h1>
        <p class='subtitle'>Premier Hair Transplant Clinic ·
          {{hospital.city}},
          {{hospital.country}}</p>
        <div class='profile-badges'>
          <span class='badge badge-green'>✓ Verified Clinic</span>
          <span class='badge badge-gold'>★ Top Rated</span>
          <span class='badge badge-blue'>{{totalProcedures}} Procedures</span>
        </div>
      </div>
      <div class='profile-actions'>
        <div class='stars' style='font-size: 18px;'>{{{stars hospital.rating}}}
          <strong style='margin-left: 4px;'>{{hospital.rating}}</strong></div>
        <a href='/contact' class='btn btn-primary btn-sm'>Book Consultation</a>
      </div>
    </div>

    <div class='detail-main'>
      <div class='detail-left'>
        <!-- About -->
        <div class='detail-card fade-in'>
          <h2>About the Hospital</h2>
       <p>
        {{hospital.description}}
       </p>
        </div>

        <!-- Facilities -->
        <div class='detail-card fade-in'>
          <h2>Facilities & Equipment</h2>
          <div class='facilities-grid' style='margin-top: 16px;'>
            {{#if hospital.facilities.jciAccredited}}
            <div class='facility-item'><div class='facility-icon'>🏥</div>
              JCI Accredited Facility</div>
            {{/if}}
            {{#if hospital.facilities.sapphireFueBlades}}
            <div class='facility-item'><div class='facility-icon'>💎</div>
              Sapphire FUE Blades</div>
            {{/if}}
            {{#if hospital.facilities.dhiChoiImplanterPens}}
            <div class='facility-item'><div class='facility-icon'>🔬</div>
              DHI Choi Implanter Pens</div>
            {{/if}}
            {{#if hospital.facility.prpTherapyLab}}
            <div class='facility-item'><div class='facility-icon'>🧬</div>
              PRP Therapy Lab</div>
            {{/if}}
            {{#if hospital.facility.digitalHairAnalysis}}
            <div class='facility-item'><div class='facility-icon'>🖥️</div>
              Digital Hair Analysis</div>
            {{/if}}
            {{#if hospital.facility.privateRecoveryRooms}}
            <div class='facility-item'><div class='facility-icon'>🛏️</div>
              Private Recovery Rooms</div>
            {{/if}}
            {{#if hospital.facility.multilingualStaff}}
            <div class='facility-item'><div class='facility-icon'>🌐</div>
              Multilingual Staff</div>
            {{/if}}
            {{#if hospital.facility.airportTransferService}}
            <div class='facility-item'><div class='facility-icon'>✈️</div>
              Airport Transfer Service</div>
            {{/if}}
            {{#if hospital.facility.hotelAccommodation}}
            <div class='facility-item'><div class='facility-icon'>🏨</div>
              Hotel Accommodation</div>
            {{/if}}
            {{#if hospital.facility.acceptCreditCard}}
            <div class='facility-item'><div class='facility-icon'>💳</div>
              Accept Credit Card</div>
            {{/if}}
          </div>
        </div>

        <!-- Pricing -->
    

        <!-- Results Gallery -->
        <div class='detail-card fade-in'>
          <h2>💬 Patient Comments</h2>
          <div class='comments-section' style='margin-top: 16px;'>

            {{#each hospital.reviews}}
              <!-- Comment 1 -->
              <div
                class='comment-item'
                style='display: flex; gap: 14px; padding: 20px 0; border-bottom: 1px solid var(--border);'
              >
                <div
                  style='width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--secondary), var(--accent)); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 16px; flex-shrink: 0;'
                >JT</div>
                <div style='flex: 1; min-width: 0;'>
                  <div
                    style='display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 6px;'
                  >
                    <strong style='font-size: 15px;'>{{this.authorName}}</strong>
                    <span class='stars' style='font-size: 12px;'>{{stars this.rating}}</span>
                    <span
                      style='font-size: 12px; color: var(--text-light); margin-left: auto;'
                    >{{relative_date this.publishTime}}</span>
                  </div>
                  <span
                    class='badge badge-green'
                    style='margin-bottom: 8px; display: inline-block;'
                  >✓ Verified Patient</span>
                  <p
                    style='font-size: 14px; color: var(--text-secondary); line-height: 1.7;'
                  >{{slice this.comment 0 200}}</p>
                </div>
              </div>
            {{/each}}

          </div>

          <!-- Load More -->
          <div style='text-align: center; margin-top: 20px;'>
            <a
              class='btn btn-outline btn-sm'
              target="_blank"
              href="{{hospital.reviewUri}}"
            >Load More Comments</a>
          </div>
        </div>
        <!-- Results Gallery -->
        <div class='detail-card fade-in'>
          <h2>Patient Results</h2>
          <div class='grid-2' style='margin-top: 16px;'>
            {{#each latestHairResults}}
              <div class='ba-card'>
                <div class='ba-images'>
                  <div class='ba-img'><img
                      src='{{this.previewImageUrl}}'
                      alt='Before'
                    /><span class='ba-label before'>Before</span></div>
                </div>
                <div class='ba-info'>
                  <h4>{{this.technique}} — {{this.graftCount}} Grafts</h4>
                  <div class='ba-meta'><span>👨‍⚕️ Dr. Mehmet Yilmaz</span><span
                    >{{relative_date this.operationDate}}</span></div>
                </div>
              </div>
            {{/each}}
          </div>
          <div style='text-align: center; margin-top: 20px;'>
            <a
              href='/clinics/{{hospital.slug}}/results'
              class='btn btn-outline btn-sm'
            >View All Results →</a>
          </div>
        </div>
      </div>

      <!-- SIDEBAR -->
      <div class='detail-sidebar'>
        <div class='sidebar-card fade-in'>
          <h3>Hospital Information</h3>
          <div class='info-row'>
            <div class='icon-sm'>📍</div>
            <div><span class='info-label'>Location</span><span
                class='info-value'
              ><a
                  href='{{hospital.directionsUri}}'
                  target='_blank'
                >{{hospital.address}}</a></span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>📞</div>
            <div><span class='info-label'>Phone</span><span
                class='info-value'
              >{{hospital.phone}}</span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'> <i class="bi bi-instagram"></i></div>
            <div><span class='info-label'>Instagram</span><span
                class='info-value'
              ><a
                  href='{{hospital.instagramUrl}}'
                  target='_blank'
                >{{hospital.instagramUrl}}</a></span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>🌐</div>
            <div><span class='info-label'>Website</span><span
                class='info-value'
              ><a
                  href='{{hospital.website}}'
                  target='_blank'
                >{{hospital.website}}</a></span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>🕐</div>
            <div><span class='info-label'>Hours</span><span class='info-value'>
                {{#each hospital.weekDayOpenings}}
                  {{this}}
                  <br />
                {{/each}}
              </span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>📅</div>
            <div><span class='info-label'>Founded</span><span
                class='info-value'
              >2008</span></div>
          </div>
          <a
            href='/contact'
            class='btn btn-primary'
            style='width: 100%; margin-top: 16px;'
          >Book Free Consultation</a>
        </div>

        <div class='sidebar-card fade-in'>
          <h3>Specializations</h3>
          <div
            style='display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px;'
          >
            {{#each hospital.techniques}}
              <span class='badge badge-blue'>{{this}}</span>
            {{/each}}
          </div>
        </div>

        <div class='sidebar-card fade-in'>
          <h3>Quick Stats</h3>
          <div class='info-row'>
            <div class='icon-sm'>🏆</div>
            <div><span class='info-label'>Total Reviews</span><span
                class='info-value'
              >{{hospital.reviewCount}}</span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>🏆</div>
            <div><span class='info-label'>Total Procedures</span><span
                class='info-value'
              >{{totalProcedures}}</span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>⭐</div>
            <div><span class='info-label'>Patient Rating</span><span
                class='info-value'
              >4.9 / 5.0</span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>✅</div>
            <div><span class='info-label'>Success Rate</span><span
                class='info-value'
              >98.5%</span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>👨‍⚕️</div>
            <div><span class='info-label'>Medical Staff</span><span
                class='info-value'
              >{{doctors.pagination.total}} professionals</span></div>
          </div>
          <div class='info-row'>
            <div class='icon-sm'>🌍</div>
            <div><span class='info-label'>Countries Served</span><span
                class='info-value'
              >80+</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>