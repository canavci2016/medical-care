<!doctype html>
<html lang='en'>
  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=utf-8' />
    <title>AdminLTE 4 | Create Hair Result</title>
    <meta name='viewport' content='width=device-width, initial-scale=1.0, user-scalable=yes' />
    <meta name='color-scheme' content='light dark' />
    <meta name='theme-color' content='#007bff' media='(prefers-color-scheme: light)' />
    <meta name='theme-color' content='#1a1a1a' media='(prefers-color-scheme: dark)' />
    <meta name='supported-color-schemes' content='light dark' />
    <link rel='preload' href='/css/admin/adminlte.css' as='style' />
    <link
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/@fontsource/source-sans-3@5.0.12/index.css'
      integrity='sha256-tXJfXfp6Ewt1ilPzLDtQnJV4hclT9XuaZUKyUvmyr+Q='
      crossorigin='anonymous'
      media='print'
      onload="this.media='all'"
    />
    <link
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css'
      crossorigin='anonymous'
    />
    <link
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css'
      crossorigin='anonymous'
    />
    <link rel='stylesheet' href='/css/admin/adminlte.css' />
  </head>
  <body class='layout-fixed sidebar-expand-lg sidebar-open bg-body-tertiary'>
    <div class='app-wrapper'>
      {{> adminheader}}
      {{> adminsidebar}}

      <main class='app-main'>
        <div class='app-content-header'>
          <div class='container-fluid'>
            <div class='row align-items-center'>
              <div class='col-sm-6'><h3 class='mb-0'>Create Hair Result Bulk</h3></div>
              <div class='col-sm-6 text-sm-end mt-2 mt-sm-0'>
                <a href='/admin/hospital-hair-results' class='btn btn-outline-secondary btn-sm'>Back to List</a>
              </div>
            </div>
          </div>
        </div>

        <div class='app-content'>
          <div class='container-fluid'>
            <div class='row'>
              <div class='col-12'>
                <div class='card card-primary card-outline mb-4'>
                  <form id='createResultForm' action='/admin/hospital-hair-results/bulk-create' method='post' enctype='multipart/form-data'>
                    <div class='card-body'>

                      <div class='form-check mb-2'>
                        <input class='form-check-input' type='checkbox' id='verified' name='verified' />
                        <label class='form-check-label' for='verified'>Verified</label>
                      </div>
                      <div class='form-check mb-2'>
                        <input class='form-check-input' type='checkbox' id='consentReceived' name='consentReceived' />
                        <label class='form-check-label' for='consentReceived'>Consent Received</label>
                      </div>
                      <div class='form-check mb-3'>
                        <input class='form-check-input' type='checkbox' id='isPublic' name='isPublic' checked />
                        <label class='form-check-label' for='isPublic'>Public</label>
                      </div>

                      <div class='mb-3'>
                        <label for='jsonPayload' class='form-label'>JSON PAYLOAD</label>
                        <textarea class='form-control' id='jsonPayload' name='jsonPayload' rows='3'></textarea>
                      </div>

                      <div class='mb-3'>
                        <label for='resultImages' class='form-label'>Attach Images (JSON File)</label>
                        <input
                          type='file'
                          class='form-control'
                          id='resultImages'
                          accept='.json,application/json'
                        />
                        <div class='form-text'>Select a JSON file containing an array payload for bulk create.</div>
                      </div>
                    </div>

                    <div class='card-footer'>
                      <div id='createResultAlert' class='alert d-none' role='alert'></div>
                      <button type='submit' class='btn btn-primary' id='createResultSubmitBtn'>Create Result</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>

      {{> adminfooter}}
    </div>

    <script
      src='https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js'
      crossorigin='anonymous'
    ></script>
    <script
      src='https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js'
      crossorigin='anonymous'
    ></script>
    <script
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js'
      crossorigin='anonymous'
    ></script>
    <script src='/scripts/admin/js/adminlte.js'></script>
    <script>
      const SELECTOR_SIDEBAR_WRAPPER = '.sidebar-wrapper';
      const Default = {
        scrollbarTheme: 'os-theme-light',
        scrollbarAutoHide: 'leave',
        scrollbarClickScroll: true,
      };
      document.addEventListener('DOMContentLoaded', function () {
        const sidebarWrapper = document.querySelector(SELECTOR_SIDEBAR_WRAPPER);
        if (sidebarWrapper && OverlayScrollbarsGlobal?.OverlayScrollbars !== undefined) {
          OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
            scrollbars: {
              theme: Default.scrollbarTheme,
              autoHide: Default.scrollbarAutoHide,
              clickScroll: Default.scrollbarClickScroll,
            },
          });
        }
      });

      document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('createResultForm');
        const alertBox = document.getElementById('createResultAlert');
        const submitButton = document.getElementById('createResultSubmitBtn');
        const resultImagesInput = document.getElementById('resultImages');
        const jsonPayloadInput = document.getElementById('jsonPayload');
        let parsedJsonPayloadFromFile = null;

        if (
          !form ||
          !alertBox ||
          !submitButton ||
          !resultImagesInput ||
          !jsonPayloadInput
        ) {
          return;
        }

        const showAlert = (message, type) => {
          alertBox.textContent = message;
          alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
          alertBox.classList.add(type === 'success' ? 'alert-success' : 'alert-danger');
        };

        resultImagesInput.addEventListener('change', async function () {
          parsedJsonPayloadFromFile = null;
          const selectedFile = resultImagesInput.files && resultImagesInput.files[0];

          if (!selectedFile) {
            return;
          }

          try {
            const content = await selectedFile.text();
            const parsed = JSON.parse(content);

            if (!Array.isArray(parsed)) {
              throw new Error('JSON file must contain an array payload.');
            }

            parsedJsonPayloadFromFile = parsed;
            jsonPayloadInput.value = JSON.stringify(parsed, null, 2);
            showAlert('JSON file loaded successfully.', 'success');
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Invalid JSON file.';
            showAlert(message, 'error');
          }
        });

        form.addEventListener('submit', async function (event) {
          event.preventDefault();
          const formData = new FormData(form);
          let jsonPayload;

          try {
            jsonPayload =
              parsedJsonPayloadFromFile ||
              JSON.parse(String(formData.get('jsonPayload') || '[]'));

            if (!Array.isArray(jsonPayload)) {
              throw new Error('JSON payload must be an array.');
            }
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Invalid JSON payload.';
            showAlert(message, 'error');
            return;
          }

          const verified = formData.get('verified') === 'on';
          const consentReceived = formData.get('consentReceived') === 'on';
          const isPublic = formData.get('isPublic') === 'on';

          const payload = jsonPayload.map((item) => ({
            ...item,
            verified,
            consentReceived,
            isPublic,
          }));

          const payloadFile = new File(
            [JSON.stringify(payload)],
            'bulk-hospital-hair-result.json',
            { type: 'application/json' },
          );

          const multipartFormData = new FormData();
          multipartFormData.append('filePayload', payloadFile);

          submitButton.disabled = true;
          alertBox.classList.add('d-none');

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: {
                Accept: 'application/json',
              },
              body: multipartFormData,
            });

            const responseText = await response.text();
            let responseBody = null;

            if (responseText) {
              try {
                responseBody = JSON.parse(responseText);
              } catch (error) {
                responseBody = null;
              }
            }

            if (!response.ok) {
              const errorMessage =
                responseBody?.message ||
                responseBody?.error ||
                response.statusText ||
                'Result could not be created.';

              throw new Error(Array.isArray(errorMessage) ? errorMessage.join(', ') : errorMessage);
            }

            showAlert('Result created successfully.', 'success');
            form.reset();
            parsedJsonPayloadFromFile = null;
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Unexpected error occurred.';
            showAlert(message, 'error');
          } finally {
            submitButton.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
